# Clerk authentication (required)
# Create keys at https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase database (required)
# Create a project and copy its URL and anon/public key from Project Settings > API.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Vapi voice assistant (required for voice conversations)
# Copy the public web token from your Vapi dashboard.
VAPI_WEB_TOKEN=

# Sentry monitoring (DSN is safe to expose to the browser)
SENTRY_DSN=
SENTRY_ORG=cybit
SENTRY_PROJECT=mentor-ai

# Sentry source-map uploads (secret; optional for local development)
SENTRY_AUTH_TOKEN=